{
  "name": "empire-code-private-pilot",
  "version": "0.0.0",
  "private": true,
  "description": "Empire Code PRIVATE-PILOT-7: browser app, Cloudflare Worker backend, local build and tests. No dependencies.",
  "scripts": {
    "build": "node candidate/build.cjs",
    "build:check": "node candidate/build.cjs --check",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "verify": "npm test && npm run build:check",
    "dev": "node local/run.mjs",
    "dev:open": "node local/run.mjs --open",
    "dev:check": "node local/run.mjs --check",
    "dev:status": "node local/run.mjs --status",
    "test:local": "node --test tests/local-*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
